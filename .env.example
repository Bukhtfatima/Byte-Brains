# ==============================================================================
# BloodBridge Global Environment Configuration
# ==============================================================================

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./bloodbridge.db
# Cloud PostgreSQL (Neon / Supabase / Render / Docker):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/bloodbridge

# Security & JWT Authentication
JWT_SECRET=super-secret-bloodbridge-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Background Automation Engine
AUTOMATION_ENABLED=true

# Server Port
PORT=8000

# Frontend Public API URL (used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# In production (e.g. Vercel connecting to Render backend):
# NEXT_PUBLIC_API_URL=https://bloodbridge-backend.onrender.com/api/v1
