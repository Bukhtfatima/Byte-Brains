# ==============================================================================
# BloodBridge Backend Environment Configuration Example
# ==============================================================================

# Application Meta
PROJECT_NAME="BloodBridge API"
VERSION="1.0.0"
API_V1_STR=/api/v1
ENVIRONMENT=development
PORT=8000

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./bloodbridge.db
# Cloud / Production PostgreSQL (e.g. Neon, Supabase, Render Postgres, Docker):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bloodbridge

# Security & JWT Authentication
JWT_SECRET=super-secret-bloodbridge-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Background Automation Engine
AUTOMATION_ENABLED=true

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
